project      = "gcp-learning-xxxx"
repo         = "your-login/gcp-learning"
region       = "europe-west2"
apply_branch = "main"

# В проде здесь группы: group:infra-devs@… и group:infra-admins@…
plan_impersonators  = ["user:you@example.com"]
apply_impersonators = ["user:you@example.com"]

# В организации запрет ключей уже наследуется от org policy (проверка:
# gcloud resource-manager org-policies list --organization=<org_id>), поэтому false
enforce_no_sa_keys = false
