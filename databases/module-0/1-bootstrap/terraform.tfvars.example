project      = "gcp-learning-xxxx"
repo         = "your-login/gcp-learning"
region       = "europe-west2"
apply_environment = "Production"

# In production these are groups: group:infra-devs@... and group:infra-admins@...
plan_impersonators  = ["user:you@example.com"]
apply_impersonators = ["user:you@example.com"]

# Inside an organization the key ban is already inherited from org policy (check:
# gcloud resource-manager org-policies list --organization=<org_id>), so false
enforce_no_sa_keys = false
